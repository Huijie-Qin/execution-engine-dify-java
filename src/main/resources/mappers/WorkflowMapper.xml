<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.agentplatform.infrastructure.mapper.WorkflowMapper">
    <resultMap id="WorkflowResultMap" type="com.example.agentplatform.domain.model.Workflow">
        <id column="id" property="id" />
        <result column="name" property="name" />
        <result column="status" property="status" />
        <result column="description" property="description" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
    </resultMap>

    <insert id="insert" parameterType="com.example.agentplatform.domain.model.Workflow" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO workflow(name, status, description)
        VALUES (#{name}, #{status}, #{description})
    </insert>

    <update id="update" parameterType="com.example.agentplatform.domain.model.Workflow">
        UPDATE workflow
        SET name = #{name},
            status = #{status},
            description = #{description}
        WHERE id = #{id}
    </update>

    <select id="findById" parameterType="long" resultMap="WorkflowResultMap">
        SELECT * FROM workflow WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="WorkflowResultMap">
        SELECT * FROM workflow ORDER BY id DESC
    </select>
</mapper>
