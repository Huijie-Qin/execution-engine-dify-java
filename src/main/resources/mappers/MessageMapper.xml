<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.agentplatform.infrastructure.mapper.MessageMapper">
    <resultMap id="MessageResultMap" type="com.example.agentplatform.domain.model.Message">
        <id column="id" property="id" />
        <result column="conversation_id" property="conversationId" />
        <result column="role" property="role" />
        <result column="content" property="content" />
        <result column="tokens" property="tokens" />
        <result column="trace_id" property="traceId" />
        <result column="created_at" property="createdAt" />
    </resultMap>

    <insert id="insert" parameterType="com.example.agentplatform.domain.model.Message" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO message(conversation_id, role, content, tokens, trace_id)
        VALUES (#{conversationId}, #{role}, #{content}, #{tokens}, #{traceId})
    </insert>

    <select id="findByConversationId" resultMap="MessageResultMap">
        SELECT * FROM message WHERE conversation_id = #{conversationId} ORDER BY id ASC
    </select>
</mapper>
