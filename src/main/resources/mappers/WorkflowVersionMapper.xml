<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.agentplatform.infrastructure.mapper.WorkflowVersionMapper">
    <resultMap id="WorkflowVersionResultMap" type="com.example.agentplatform.domain.model.WorkflowVersion">
        <id column="id" property="id" />
        <result column="workflow_id" property="workflowId" />
        <result column="graph_json" property="graphJson" />
        <result column="variables_json" property="variablesJson" />
        <result column="status" property="status" />
        <result column="created_at" property="createdAt" />
    </resultMap>

    <insert id="insert" parameterType="com.example.agentplatform.domain.model.WorkflowVersion" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO workflow_version(workflow_id, graph_json, variables_json, status)
        VALUES (#{workflowId}, #{graphJson}, #{variablesJson}, #{status})
    </insert>

    <update id="updateStatus">
        UPDATE workflow_version SET status = #{status} WHERE id = #{id}
    </update>

    <select id="findLatestByWorkflowId" resultMap="WorkflowVersionResultMap">
        SELECT * FROM workflow_version WHERE workflow_id = #{workflowId} ORDER BY id DESC LIMIT 1
    </select>

    <select id="findById" resultMap="WorkflowVersionResultMap">
        SELECT * FROM workflow_version WHERE id = #{id}
    </select>

    <select id="findByWorkflowId" resultMap="WorkflowVersionResultMap">
        SELECT * FROM workflow_version WHERE workflow_id = #{workflowId} ORDER BY id DESC
    </select>
</mapper>
