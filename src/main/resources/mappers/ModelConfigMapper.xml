<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.agentplatform.infrastructure.mapper.ModelConfigMapper">
    <resultMap id="ModelConfigResultMap" type="com.example.agentplatform.domain.model.ModelConfig">
        <id column="id" property="id" />
        <result column="provider" property="provider" />
        <result column="model_name" property="modelName" />
        <result column="base_url" property="baseUrl" />
        <result column="api_key_alias" property="apiKeyAlias" />
        <result column="timeout_ms" property="timeoutMs" />
        <result column="max_tokens" property="maxTokens" />
        <result column="extra_json" property="extraJson" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
    </resultMap>

    <insert id="insert" parameterType="com.example.agentplatform.domain.model.ModelConfig" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO model_config(provider, model_name, base_url, api_key_alias, timeout_ms, max_tokens, extra_json)
        VALUES (#{provider}, #{modelName}, #{baseUrl}, #{apiKeyAlias}, #{timeoutMs}, #{maxTokens}, #{extraJson})
    </insert>

    <update id="update" parameterType="com.example.agentplatform.domain.model.ModelConfig">
        UPDATE model_config
        SET provider = #{provider},
            model_name = #{modelName},
            base_url = #{baseUrl},
            api_key_alias = #{apiKeyAlias},
            timeout_ms = #{timeoutMs},
            max_tokens = #{maxTokens},
            extra_json = #{extraJson}
        WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM model_config WHERE id = #{id}
    </delete>

    <select id="findAll" resultMap="ModelConfigResultMap">
        SELECT * FROM model_config ORDER BY id DESC
    </select>

    <select id="findById" resultMap="ModelConfigResultMap">
        SELECT * FROM model_config WHERE id = #{id}
    </select>
</mapper>
