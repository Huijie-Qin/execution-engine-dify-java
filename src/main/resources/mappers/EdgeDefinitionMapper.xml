<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.agentplatform.infrastructure.mapper.EdgeDefinitionMapper">
    <resultMap id="EdgeResultMap" type="com.example.agentplatform.domain.model.EdgeDefinition">
        <id column="id" property="id" />
        <result column="workflow_version_id" property="workflowVersionId" />
        <result column="from_node_id" property="fromNodeId" />
        <result column="to_node_id" property="toNodeId" />
        <result column="condition_json" property="conditionJson" />
    </resultMap>

    <insert id="insert" parameterType="com.example.agentplatform.domain.model.EdgeDefinition" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO edge(workflow_version_id, from_node_id, to_node_id, condition_json)
        VALUES (#{workflowVersionId}, #{fromNodeId}, #{toNodeId}, #{conditionJson})
    </insert>

    <select id="findByWorkflowVersionId" resultMap="EdgeResultMap">
        SELECT * FROM edge WHERE workflow_version_id = #{workflowVersionId}
    </select>
</mapper>
